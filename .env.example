# ===== إعدادات عامة =====
PORT=3000
# عنوان الموقع النهائي (يُستخدم في روابط المشاركة). مثال: https://projects.mycompany.com
BASE_URL=
# حساب المسؤول الأول (يُنشأ مرة واحدة عند أول تشغيل)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=غيّر-هذه-الكلمة
# اختياري: نص عشوائي طويل. إن تركته فارغاً يُنشأ ويُحفظ تلقائياً.
SESSION_SECRET=
# أقصى حجم رفع من الموقع (ميغابايت). الفيديوهات الكبيرة ارفعها مباشرة في Drive.
MAX_UPLOAD_MB=1024

# ===== Google Drive =====
# معرّف المجلد الرئيسي (الجزء الأخير من رابط المجلد: drive.google.com/drive/folders/XXXXXXXX)
DRIVE_ROOT_FOLDER_ID=https://drive.google.com/drive/folders/1-v7inLvq4NM9O0lzYlvNalQzIEjs9Dth?usp=sharing

# الطريقة أ (موصى بها لحساب Gmail عادي — تسمح بالرفع من الموقع):
GOOGLE_CLIENT_ID=639111423529-q3uqf7638bmmff648i3a5g1dangipt32.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
GOOGLE_REFRESH_TOKEN=https://oauth2.googleapis.com/token

